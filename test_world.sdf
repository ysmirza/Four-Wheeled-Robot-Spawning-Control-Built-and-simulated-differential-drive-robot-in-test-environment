<?xml version="1.0" ?> 
<sdf version="1.7"> 
	<world name="demo_world"> 
		<!-- A flat ground -->
		<model name="flat_ground"> 
			<static>true</static> 
			<link name="ground_link"> 
				<collision name="ground_collision"> 
					<geometry>
						<plane> 
							<normal>0 0 1</normal> 
							<size>10 10</size> 
						</plane> 
					</geometry> 
				</collision> 
				<visual name="ground_visual"> 
					<geometry> 
						<plane> 
							<normal>0 0 1</normal> 
							<size>10 10</size> 
						</plane> 
					</geometry> 
					<material> 
						<ambient>0.3 0.3 0.3 1</ambient> 
						<diffuse>0.5 0.5 0.5 1</diffuse> 
					</material> 
				</visual> 
			</link> 
		</model> 
		<model name="simple_bot"> 
			<!-- Chassis --> 
			<link name="chassis"> 
				<pose>0 0 0.1 0 0 0</pose> 
				<inertial> 
					<mass>1.0</mass> 
					<inertia> 
						<ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz> 
						<ixy>0.0</ixy><ixz>0.0</ixz><iyz>0.0</iyz> 
					</inertia> 
				</inertial> 
				<collision name="chassis_collision"> 
					<geometry> 
						<box> 
							<size>0.2 0.3 0.1</size> 
						</box> 
					</geometry> 
				</collision> 
				<visual name="chassis_visual"> 
					<geometry> 
						<box> 
							<size>0.2 0.3 0.1</size> 
						</box> 
					</geometry> 
					<material> 
						<ambient>0 0 1 1</ambient> 
						<diffuse>0 0.8 1</diffuse> 
						<specular>0.5 0.5 0.5 1</specular> 
						<emissive>0 0 1</emissive> 
					</material> 
				</visual> 
			</link> 

			<!-- Left Front Wheel --> 
			<link name="left_front_wheel"> 
				<pose>-0.11 0.1 0.07 0 1.57 0</pose> 
				<inertial> 
					<mass>0.2</mass> 
					<inertia> 
						<ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz> 
						<ixy>0.0</ixy><ixz>0.0</ixz><iyz>0.0</iyz> 
					</inertia> 
				</inertial> 
				<collision name="left_front_wheel_collision"> 
					<geometry> 
						<cylinder> 
							<radius>0.07</radius> 
							<length>0.02</length> 
						</cylinder> 
					</geometry> 
				</collision> 
				<visual name="left_front_wheel_visual"> 
					<geometry> 
						<cylinder> 
							<radius>0.07</radius> 
							<length>0.02</length> 
						</cylinder> 
					</geometry> 
				</visual> 
			</link> 
			
			<!-- Left Back Wheel --> 
			<link name="left_back_wheel"> 
				<pose>0.11 0.1 0.07 0 1.57 0</pose> 
				<inertial> 
					<mass>0.2</mass> 
					<inertia> 
						<ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz> 
						<ixy>0.0</ixy><ixz>0.0</ixz><iyz>0.0</iyz> 
					</inertia> 
				</inertial> 
				<collision name="Left_back_wheel_collision"> 
					<geometry> 
						<cylinder> 
							<radius>0.07</radius> 
							<length>0.02</length> 
						</cylinder> 
					</geometry> 
				</collision> 
				<visual name="Left_back_wheel_visual"> 
					<geometry> 
						<cylinder> 
							<radius>0.07</radius> 
							<length>0.02</length> 
						</cylinder> 
					</geometry> 
				</visual> 
			</link> 
		
			<!-- Right Front wheel --> 
			<link name="right_front_wheel"> 
				<pose>-0.11 -0.1 0.07 0 1.57 0</pose> 
				<inertial> 
					<mass>0.2</mass> 
					<inertia> 
						<ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz> 
						<ixy>0.0</ixy><ixz>0.0</ixz><iyz>0.0</iyz> 
					</inertia> 
				</inertial> 
				<collision name="right_front_wheel_collision"> 
					<geometry> 
						<cylinder> 	
							<radius>0.07</radius> 
							<length>0.02</length> 
						</cylinder> 
					</geometry> 
				</collision> 
				<visual name="right_front_wheel_visual"> 
					<geometry> 
						<cylinder> 
							<radius>0.07</radius> 
							<length>0.02</length> 
						</cylinder> 
					</geometry> 
				</visual> 
			</link> 

			<!-- Right Back Wheel --> 
			<link name="right_back_wheel"> 
				<pose>0.11 -0.1 0.07 0 1.57 0 </pose> 
				<inertial> 
					<mass>0.2</mass> 
					<inertia> 
						<ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz> 
						<ixy>0.0</ixy><ixz>0.0</ixz><iyz>0.0</iyz> 
					</inertia> 
				</inertial> 
				<collision name="right_back_wheel_collision"> 
					<geometry> 
						<cylinder> 
							<radius>0.07</radius> 
							<length>0.02</length> 
						</cylinder> 
					</geometry> 
				</collision> 
				<visual name="right_back_wheel_visual"> 
					<geometry> 
						<cylinder> 
							<radius>0.07</radius> 
							<length>0.02</length> 
						</cylinder> 
					</geometry> 
				</visual> 
			</link> 
	
			<!-- Joints --> 
			<joint name="left_front_wheel_joint" type="revolute"> 
				<parent>chassis</parent> 
				<child>left_front_wheel</child> 
				<axis> 
					<xyz>0 1 0</xyz> <!-- rotate around Y --> 
					<limit> 
						<lower>-1e16</lower> 
						<upper>1e16</upper> 
					</limit> 
				</axis> 
			</joint>

			<joint name="left_back_wheel_joint" type="revolute"> 
				<parent>chassis</parent> 
				<child>left_back_wheel</child> 
				<axis> 
					<xyz>0 1 0</xyz> <!-- rotate around Y --> 
					<limit> 
						<lower>-1e16</lower> 
						<upper>1e16</upper> 
					</limit> 
				</axis> 
			</joint> 

			<joint name="right_front_wheel_joint" type="revolute"> 
				<parent>chassis</parent> 	
				<child>right_front_wheel</child> 
				<axis> 
					<xyz>0 1 0</xyz> <!-- rotate around Y --> 
					<limit> 
						<lower>-1e16</lower> 
						<upper>1e16</upper> 
					</limit> 
				</axis> 
			</joint> 

			<joint name="right_back_wheel_joint" type="revolute"> 
				<parent>chassis</parent> 	
				<child>right_back_wheel</child> 
				<axis> 
					<xyz>0 1 0</xyz> <!-- rotate around Y --> 
					<limit> 
						<lower>-1e16</lower> 
						<upper>1e16</upper> 
					</limit> 
				</axis> 
			</joint>

			<!-- Differential Drive Plugin --> 
			<plugin name="gz::sim::systems::DiffDrive" filename="libgz-sim-diff-drive-system.so"> 
				<left_joint>left_back_wheel_joint</left_joint> 
				<right_joint>right_back_wheel_joint</right_joint> 									<wheel_separation>0.2</wheel_separation> 
				<wheel_radius>0.07</wheel_radius> 
				<odom_publish_frequency>50</odom_publish_frequency> 
					<topic>cmd_vel</topic>
			</plugin> 
		</model> 
	</world> 
</sdf>
